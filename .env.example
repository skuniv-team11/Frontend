# Cloudflare Pages: Settings → Environment variables. 넣지 않으면 아래 값이 기본값이다(src/api/client.js · src/api/application.js).
# 로컬(npm run dev·preview)도 이 파일 없이 기본값을 쓴다. VITE_ 값은 브라우저에 그대로 보이므로 주소만 넣는다.
VITE_API_BASE_URL=https://coop-radar-api.onrender.com
# 학과(부)장 승인 링크의 화면 주소(선택)
VITE_PUBLIC_ORIGIN=https://fieldrun.pages.dev
